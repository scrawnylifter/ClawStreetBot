# ── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
# NEVER commit real secrets
.env
.env.*
!.env.example

# ── Docker ──────────────────────────────────────────
# Volumes are managed by docker-compose — no local state to track

# ── IDE / OS ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Data (large files — rescraped, not committed) ──
*.csv
*.parquet
*.db
*.sqlite3

# ── Testing ──────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── n8n (workflows managed in UI, exported to docs/) ──
n8n_data/

# ── Obsidian workspace (personal, not shared) ───────
docs/obsidian/.obsidian/