# ClawStreetBot v2 — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env.

# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=cbs
POSTGRES_PASSWORD=*** REQUIRED — set a strong password
POSTGRES_DB=clawstreetbot
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=*** REQUIRED — set a strong password
REDIS_PORT=6379

# ── n8n ───────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=*** REQUIRED — set a strong password
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http          # http for local/lan; https only behind a reverse proxy
N8N_EDITOR_BASE_URL=       # e.g. https://n8n.yourdomain.com (leave blank for local)
N8N_WEBHOOK_URL=           # e.g. https://n8n.yourdomain.com/ (leave blank for local)

# ── Obsidian ──────────────────────────────────────────────
OBSIDIAN_USER=cbs
OBSIDIAN_PASSWORD=*** REQUIRED — set a strong password
OBSIDIAN_HTTP_PORT=3000
OBSIDIAN_HTTPS_PORT=3001
# Local REST API plugin — backs the Obsidian MCP server (see .mcp.json).
# Generate a key: head -c32 /dev/urandom | od -An -tx1 | tr -d ' \n'
OBSIDIAN_API_KEY=*** REQUIRED for the MCP server — 64-char hex
OBSIDIAN_REST_HTTP_PORT=27123
OBSIDIAN_REST_HTTPS_PORT=27124

# ── Alpaca (trading API) ──────────────────────────────────
ALPACA_API_KEY=*** REQUIRED for 01_data and 05_execution
ALPACA_SECRET_KEY=*** REQUIRED for 01_data and 05_execution
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # use paper for dev

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=*** REQUIRED for 03_alert and 04_approval
TELEGRAM_CHAT_ID=                # REQUIRED — your chat ID

# ── Application ──────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development           # development | staging | production

# ── Docker user mapping ───────────────────────────────────
PUID=1001
PGID=1001
TZ=America/New_York