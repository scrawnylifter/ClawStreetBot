# n8n service config. Copy to .env.n8n and fill in real values.

# Basic auth for the n8n UI (http://localhost:5678)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=clawstreet
N8N_BASIC_AUTH_PASSWORD=change-me-now

# 32-char random string; required for credential encryption.
# Generate with: openssl rand -hex 16
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-16

# Timezone used for cron triggers (and shown in the UI).
GENERIC_TIMEZONE=America/New_York
TZ=America/New_York

# Host port the n8n UI is exposed on (container always listens on 5678).
N8N_HOST_PORT=5678

# GID of the host's docker group — used by docker-proxy (NOT n8n) to read
# /var/run/docker.sock as an unprivileged user. n8n itself has no host
# socket access; it talks HTTP to docker-proxy.
# Find with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=988

# API key for programmatic workflow management (generated via n8n UI).
# Create: Settings > API > Create API Key
N8N_API_KEY=replace-with-api-key-from-n8n-ui
