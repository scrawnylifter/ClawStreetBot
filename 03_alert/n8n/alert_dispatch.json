{
  "name": "alert_dispatch",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/2 6-13 * * 1-5"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Market Hours Every 2m",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "command": "docker exec clawstreet-worker python /app/03_alert/scripts/alert_telegram.py"
      },
      "id": "dispatch",
      "name": "Send Alerts",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    }
  ],
  "connections": {
    "Market Hours Every 2m": {
      "main": [
        [
          {
            "node": "Send Alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "executionTimeout": 300,
    "timezone": "America/Los_Angeles"
  }
}