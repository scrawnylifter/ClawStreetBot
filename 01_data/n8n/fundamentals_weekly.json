{
  "name": "fundamentals_weekly",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 6"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Saturday 09:00 PDT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "docker exec clawstreet-worker python /app/01_data/scripts/ingest_yfinance_fundamentals.py --all"
      },
      "id": "run",
      "name": "ingest fundamentals (yfinance)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Saturday 09:00 PDT": {
      "main": [
        [
          {
            "node": "ingest fundamentals (yfinance)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "executionTimeout": 1800,
    "timezone": "America/Los_Angeles"
  },
  "active": true
}
