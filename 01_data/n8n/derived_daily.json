  "connections": {
    "Weekdays 15:30 PDT": {
      "main": [
        [
          {
            "node": "compute realized vol",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "compute realized vol": {
      "main": [
        [
          {
            "node": "ingest alpaca iv",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ingest alpaca iv": {
      "main": [
        [
          {
            "node": "compute iv rank",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "compute iv rank": {
      "main": [
        [
          {
            "node": "compute gex/dex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "compute gex/dex": {
      "main": [
        [
          {
            "node": "compute technical indicators",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "compute technical indicators": {
      "main": [
        [
          {
            "node": "compute greeks filter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "compute greeks filter": {
      "main": [
        [
          {
            "node": "compute iv outliers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "executionTimeout": 1800,
    "timezone": "America/Los_Angeles"
  },
  "active": true
}