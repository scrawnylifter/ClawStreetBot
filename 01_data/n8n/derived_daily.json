    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 15 * * 1-5"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Weekdays 15:30 PDT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "command": "docker exec clawstreet-worker python /app/01_data/scripts/compute_realized_vol.py"
      },
      "id": "rv",
      "name": "compute realized vol",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
