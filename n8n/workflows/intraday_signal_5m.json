{
  "name": "intraday_signal_5m",
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "executionTimeout": 300,
    "timezone": "America/Los_Angeles"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 6-12 * * 1-5"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Every 5min market hours PDT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "command": "docker exec clawstreet-worker python /app/scripts/intraday_signal.py --threshold 60"
      },
      "id": "run",
      "name": "Intraday Signal Refresh",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    }
  ],
  "connections": {
    "Every 5min market hours PDT": {
      "main": [
        [
          {
            "node": "Intraday Signal Refresh",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}