{
  "name": "options_daily",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "55 17 * * 1-5"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Weekdays 17:55 ET",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "docker exec clawstreet-worker python /app/scripts/ingest_polygon_options.py"
      },
      "id": "run",
      "name": "ingest options + greeks",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Weekdays 17:55 ET": {
      "main": [
        [
          {
            "node": "ingest options + greeks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "executionTimeout": 1800,
    "timezone": "America/New_York"
  },
  "active": true
}