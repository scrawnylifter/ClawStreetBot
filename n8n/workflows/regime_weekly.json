{
  "name": "regime_weekly",
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "executionTimeout": 1800,
    "timezone": "America/Los_Angeles"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 6"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Saturday 8:00 PDT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "command": "docker exec clawstreet-worker python /app/scripts/regime_backtest.py all --start 2024-05-01 --end $(date -d '-1 day' +%Y-%m-%d) --mode swing"
      },
      "id": "classify",
      "name": "Classify + Analyze + Optimize + Compare",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    }
  ],
  "connections": {
    "Saturday 8:00 PDT": {
      "main": [
        [
          {
            "node": "Classify + Analyze + Optimize + Compare",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}