{
  "name": "execute_trade",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "* 6-13 * * 1-5"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Every minute market hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "command": "docker exec clawstreet-worker python /app/scripts/execute_trade.py --confirm --limit 5"
      },
      "id": "run",
      "name": "submit approved orders",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Every minute market hours": {
      "main": [
        [
          {
            "node": "submit approved orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "executionTimeout": 120,
    "timezone": "America/Los_Angeles"
  },
  "active": true
}
