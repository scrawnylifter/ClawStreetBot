{
  "name": "signals_daily",
  "settings": {"executionOrder": "v1", "saveManualExecutions": true, "executionTimeout": 1800},
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {"field": "cronExpression", "expression": "30 19 * * 1-5"}
          ]
        }
      },
      "id": "trigger",
      "name": "Mon-Fri 19:30 ET",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "command": "docker exec clawstreet-worker python /app/scripts/generate_signals.py --all"
      },
      "id": "run",
      "name": "generate signals",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [520, 300]
    },
    {
      "parameters": {
        "command": "cd /app && python scripts/backtest.py --mode swing --start 2025-05-15 --end 2026-05-15 --capital 10000 --threshold 50 --name daily_swing_365d"
      },
      "id": "swing-backtest",
      "name": "Swing Backtest (365d)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [780, 200]
    },
    {
      "parameters": {
        "command": "cd /app && python scripts/backtest.py --mode long_term --start 2024-05-15 --end 2026-05-15 --capital 10000 --threshold 50 --name daily_lt_730d"
      },
      "id": "lt-backtest",
      "name": "LT Backtest (730d)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [780, 400]
    }
  ],
  "connections": {
    "Mon-Fri 19:30 ET": {
      "main": [[{"node": "generate signals", "type": "main", "index": 0}]]
    },
    "generate signals": {
      "main": [[
        {"node": "Swing Backtest (365d)", "type": "main", "index": 0},
        {"node": "LT Backtest (730d)", "type": "main", "index": 0}
      ]]
    }
  }
}